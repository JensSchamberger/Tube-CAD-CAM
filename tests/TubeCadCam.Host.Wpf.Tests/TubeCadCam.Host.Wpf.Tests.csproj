<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-only UI smoke tests (real WPF window, binding-error detection). Not part of TubeCadCam.slnx so that
    `dotnet test` on Linux stays green; CI runs it explicitly on windows-latest. On non-Windows hosts it can be built but not run.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\TubeCadCam.Host.Wpf\TubeCadCam.Host.Wpf.csproj" />
    <ProjectReference Include="..\..\src\TubeCadCam.Presentation\TubeCadCam.Presentation.csproj" />
    <ProjectReference Include="..\..\src\TubeCadCam.Infrastructure\TubeCadCam.Infrastructure.csproj" />
  </ItemGroup>
</Project>
