<Window x:Class="TubeCadCam.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TubeCadCam.Host.Wpf"
        xmlns:pres="clr-namespace:TubeCadCam.Presentation;assembly=TubeCadCam.Presentation"
        Title="{Binding Title}" Height="820" Width="1280" MinHeight="600" MinWidth="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <local:LoopsToGeometryConverter x:Key="LoopsToGeometry" />
        <local:FeatureKindLabelConverter x:Key="FeatureKindLabel" />
        <local:ProfileKindLabelConverter x:Key="ProfileKindLabel" />
        <Style x:Key="HideWhenNull" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ParameterRow">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveFeatureCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neu" InputGestureText="Strg+N" Command="{Binding NewCommand}" />
                <MenuItem Header="_Öffnen…" InputGestureText="Strg+O" Command="{Binding OpenCommand}" />
                <MenuItem Header="_Speichern" InputGestureText="Strg+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="Speichern _unter…" Command="{Binding SaveAsCommand}" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem Header="2D-Querschnitt / 3D-Modell umschalten" Command="{Binding ToggleViewModeCommand}" />
                <MenuItem Header="Einpassen" Command="{Binding FitViewCommand}" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="NC-Ausgabe gesperrt – keine validierte Schneidtechnologie" Foreground="Firebrick" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <GroupBox Header="Bauteil" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Material" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Text="Länge [mm]" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LengthMm, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Profil" Padding="6" DataContext="{Binding ProfileEditor}">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ProfileKindLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParameterRow}" />
                            <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource B2V}}">
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Text="Außenkontur (eine Zeile je Punkt: x;y in mm)" />
                                <TextBox Text="{Binding CustomOuterText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,0,4" />
                                <TextBlock Text="Innenkonturen (durch Leerzeile getrennt)" />
                                <TextBox Text="{Binding CustomVoidsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"
                                       Text="{Binding AreaText}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Profilbibliothek" Padding="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Library.Status}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding Library.Entries}" SelectedItem="{Binding Library.Selected}"
                                     DisplayMemberPath="Display" MaxHeight="120" />
                            <Button Content="Profil übernehmen" Command="{Binding ApplyLibraryEntryCommand}" Margin="0,4,0,8" />
                            <TextBlock Text="Aktuelles Profil als eigenes Profil speichern:" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LibraryDesignation, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Speichern" Command="{Binding SaveToLibraryCommand}" Margin="4,0,0,0" Padding="8,0" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Bearbeitungen (Features)" Padding="6">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding FeatureKinds}" SelectedItem="{Binding NewFeatureKind}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FeatureKindLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="Hinzufügen" Padding="8,0" Margin="4,0,0,0"
                                        Command="{Binding AddFeatureCommand}" CommandParameter="{Binding NewFeatureKind}" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}"
                                     DisplayMemberPath="ListLabel" MinHeight="70" MaxHeight="150" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                <Button Content="Duplizieren" Command="{Binding DuplicateFeatureCommand}" Padding="8,0" />
                                <Button Content="Löschen (Entf)" Command="{Binding RemoveFeatureCommand}" Padding="8,0" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel DataContext="{Binding SelectedFeature}" Style="{StaticResource HideWhenNull}">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding FailureText}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Visibility="{Binding HasFailed, Converter={StaticResource B2V}}" />
                                <StackPanel Visibility="{Binding HasEnd, Converter={StaticResource B2V}}" Margin="0,0,0,4">
                                    <TextBlock Text="Rohrende (Start = x 0, Ende = x Länge)" />
                                    <ComboBox ItemsSource="{Binding Ends}" SelectedItem="{Binding End}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParameterRow}" />
                                <StackPanel Visibility="{Binding HasContourText, Converter={StaticResource B2V}}">
                                    <TextBlock Text="Kontur (x;y je Zeile, lokales Feature-System in mm)" />
                                    <TextBox Text="{Binding ContourText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <ToolBar Grid.Row="0">
                    <Button Content="2D / 3D" Command="{Binding ToggleViewModeCommand}" />
                    <Separator />
                    <Button Content="Einpassen" Command="{Binding FitViewCommand}" />
                    <Button Content="Isometrie" Command="{Binding SetViewCommand}" CommandParameter="{x:Static pres:ViewPreset.Isometric}" />
                    <Button Content="Seite" Command="{Binding SetViewCommand}" CommandParameter="{x:Static pres:ViewPreset.Side}" />
                    <Button Content="Oben" Command="{Binding SetViewCommand}" CommandParameter="{x:Static pres:ViewPreset.Top}" />
                    <Button Content="Stirn" Command="{Binding SetViewCommand}" CommandParameter="{x:Static pres:ViewPreset.End}" />
                    <Separator />
                    <CheckBox Content="Feature-Vorschau (transparent)" IsChecked="{Binding ShowFeaturePreview}" VerticalAlignment="Center" />
                </ToolBar>
                <Grid Grid.Row="1">
                    <local:SceneView x:Name="Scene3D" Visibility="{Binding Is3D, Converter={StaticResource B2V}}" />
                    <Border Background="#FFF4F5F7" Visibility="{Binding Is2D, Converter={StaticResource B2V}}" DataContext="{Binding ProfileEditor}">
                        <Viewbox Margin="24">
                            <Path Data="{Binding PreviewLoops, Converter={StaticResource LoopsToGeometry}}"
                                  Fill="#FFB4BCC6" Stroke="#FF2B2F36" StrokeThickness="1.2" Width="200" Height="200" Stretch="None" />
                        </Viewbox>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Validierung" FontWeight="SemiBold" Margin="4,0" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Issues}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Firebrick" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="DarkGoldenrod" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
