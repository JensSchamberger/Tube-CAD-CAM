<UserControl x:Class="TubeCadCam.Host.Wpf.SceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid x:Name="Surface" Background="#FF2B2F36">
        <Viewport3D x:Name="Viewport" ClipToBounds="True" />
        <TextBlock Margin="8" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="#FFBBBBBB" FontSize="11"
                   TextWrapping="Wrap" MaxWidth="560"
                   Text="Links ziehen: drehen · Rechts/Mitte ziehen: verschieben · Rad: zoomen · Klick auf eine Öffnung (Lochwand): Feature wählen. Der Körper zeigt die tatsächlich berechneten Öffnungen. Die optionale transparente Vorschau ist nur eine Hilfe und kein Nachweis, dass ein Feature angewendet wurde." />
    </Grid>
</UserControl>
